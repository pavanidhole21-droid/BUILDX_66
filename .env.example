# BloodHelp Environment Configuration Template
# Prefix variables with EXPO_PUBLIC_ to expose them safely to the client app

EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_API_URL=https://api.bloodhelp.org/v1
EXPO_PUBLIC_SUPABASE_URL=https://xyzcompany.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key-here
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here
